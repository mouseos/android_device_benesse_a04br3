# TAB-A04-BR3 board rc (imported by init.mt8167.rc).
# Based on the BSP aiot8362am3_64_bsp init.project.rc; camera/AF nodes of
# that board are dropped.

on init
    # The BSP rc files use the MediaTek alias for the eMMC; AOSP init does not
    # create it, the kernel names the controller soc/11120000.mmc.
    symlink /dev/block/platform/soc/11120000.mmc /dev/block/platform/bootdevice
    mount tmpfs tmpfs /storage/usbotg mode=0755,uid=1000,gid=1000

on boot
    # Resistive touch (BU21025) calibration, tslib-style (a0..a6, xres, yres).
    # The stock firmware's ts_calibrator wrote it from /factory/calibration;
    # these are the values of the unit's factory partition.
    write /sys/module/bu21025/parameters/calibration 70262,-168,-2916712,-70,75135,-3223792,65536,1280,800

on post-fs-data
    # No nvdata partition in this GPT: keep NVRAM on /data, where the stock
    # Android 7 firmware kept it (/data/nvram).
    mkdir /data/vendor/nvdata 0771 root system
    mount none /data/vendor/nvdata /mnt/vendor/nvdata bind
    chown root system /mnt/vendor/nvdata
    chmod 0771 /mnt/vendor/nvdata
    mkdir /mnt/vendor/nvdata/media 0771 media audio
    restorecon_recursive /mnt/vendor/nvdata

    # Define device for ATCID
    chmod 660 /dev/ttyGS0
    chown system /dev/ttyGS0
    chmod 660 /dev/ttyGS1
    chown system /dev/ttyGS1

    # WiFi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot
