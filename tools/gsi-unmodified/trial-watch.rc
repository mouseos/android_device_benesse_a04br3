# Temporary test harness, never part of the GSI or normal vendor product.
# The shell domain and powerctl permission exist in production AOSP policy.
service gsi_trial_watch /system/bin/sh -c "sleep 240; setprop sys.powerctl reboot,recovery"
    user root
    group root shell
    seclabel u:r:shell:s0
    disabled
    oneshot

service gsi_trial_capture /system/bin/sh -c "sleep 60; getprop > /data/local/tmp/gsi-trial-properties.txt; screencap -p /data/local/tmp/gsi-trial-screen.png; logcat -d -b all > /data/local/tmp/gsi-trial-logcat.txt; sleep 120; getprop > /data/local/tmp/gsi-trial-properties-final.txt; screencap -p /data/local/tmp/gsi-trial-screen-final.png"
    user root
    group root shell log graphics
    seclabel u:r:shell:s0
    disabled
    oneshot

on init
    start gsi_trial_watch
    start gsi_trial_capture
