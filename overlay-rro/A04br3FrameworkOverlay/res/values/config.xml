<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The BSP overlay lists no mobile network (Wi-Fi only unit), so
         TelephonyManager.getPhoneCount() is 0; the AOSP 10 PhoneSwitcher then
         throws ArrayIndexOutOfBoundsException on every network request and
         com.android.phone crash-loops. Declare one (radio-less) mobile
         network. The MediaTek-only "tedongle" type 49 is dropped: AOSP's
         ConnectivityService rejects it. -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,2,-1,true"</item>
        <item>"mobile,0,0,0,-1,true"</item>
        <item>"ethernet,9,9,0,-1,true"</item>
        <item>"wifi_p2p,13,1,0,-1,true"</item>
    </string-array>
    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"0,1"</item>
        <item>"7,1"</item>
        <item>"9,1"</item>
    </string-array>
</resources>
